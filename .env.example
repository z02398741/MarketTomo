# ─── AI Keyword Expansion (optional) ──────────────────────────────────────────
# Google Gemini API key — enables the AI keyword suggestion feature.
# Get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model to use (optional, defaults to gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# LLM provider selection (optional, defaults to "gemini")
# AI_PROVIDER=gemini

# ─── Supabase Tracking (optional) ──────────────────────────────────────────────
# When set, tracked items are persisted to Supabase in addition to localStorage.
# Run supabase/migrations/001_tracked_items.sql against your project first.
# Get these values from your Supabase project → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
